{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Module",
            "type": "python",
            "request": "launch",
            "module": "OPE_IsoGen.cli.main",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "export-cad",
                "--file",
                "examples/simple_pipeline.txt",
                "--settings",
                "settings/default_settings.toml"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "export-geometry-test",
            "type": "python",
            "request": "launch",
            "module": "OPE_IsoGen.cli.main",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "export-geometry-test",
                "--mode", "BOTH" ,
                "--outdir", "out/tests"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}